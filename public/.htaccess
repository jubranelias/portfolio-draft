# Single-page app on Apache (cPanel hosting such as 961host):
# serve index.html for every address that isn't a real file, so deep links and refreshes work.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# If the rewrite above is off, still land on the app rather than the server's error page
ErrorDocument 404 /index.html

# Long cache for fingerprinted assets, no cache for the HTML shell
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|webp|png|jpg|svg|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Serve compressed text where the server supports it
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
